{
  "name": "lp-crm-api",
  "version": "0.2.0",
  "description": "Read-only LP-CRM API client and MCP server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lp-crm-mcp": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "author": "Danny Chirkov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannychirkov/lp-crm-api.git"
  },
  "homepage": "https://github.com/dannychirkov/lp-crm-api#readme",
  "bugs": {
    "url": "https://github.com/dannychirkov/lp-crm-api/issues"
  },
  "keywords": [
    "lp-crm",
    "crm",
    "api",
    "mcp",
    "model-context-protocol",
    "typescript",
    "readonly"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "tsx --test test/*.test.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
